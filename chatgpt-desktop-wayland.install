cleanup_old_updater() {
    local helper="/opt/chatgpt-desktop-wayland/.codex-linux/codex-no-updater-transition-cleanup.sh"
    if [[ -f "$helper" ]]; then
        # shellcheck disable=SC1090
        . "$helper"
        codex_no_updater_cleanup_update_manager_service || true
    fi
}

post_install() {
    command -v update-desktop-database >/dev/null 2>&1 && \
        update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
    cleanup_old_updater
    printf '%s\n' \
        'chatgpt-desktop-wayland: enable the ydotool user service if Computer Use reports no input daemon:' \
        '  systemctl --user enable --now ydotool.service' >&2
}

post_upgrade() {
    post_install
}

pre_remove() {
    cleanup_old_updater
}
