+/// Share the fallback order with doctor. Niri's GNOME-compatible Screenshot
+/// service does not capture multi-output desktops; grim uses its screencopy
+/// protocol directly. Other desktops retain their GNOME routes before grim.
+pub(crate) fn screenshot_backend_order(niri_session: bool) -> &'static [ScreenshotBackend] {
+    use ScreenshotBackend::*;
+    if niri_session {
+        &[Grim, Portal, X11, GnomeScreenshot]
+    } else {
+        &[
+            GnomeShell,
+            GnomeExtension,
+            Grim,
+            Portal,
+            X11,
+            GnomeScreenshot,
+        ]
+    }
